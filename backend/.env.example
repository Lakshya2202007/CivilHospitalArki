# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS (comma-separate for several)
CLIENT_URL=http://localhost:5173

# ─── Auth ─────────────────────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ─── Firebase (Firestore) ─────────────────────────────────
# Easiest: download the service-account JSON from
# Firebase Console > Project settings > Service accounts, save it as
# backend/serviceAccountKey.json (already gitignored) and point at it:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Or supply the fields individually instead (useful on hosted platforms).
# Keep the \n escapes inside the private key on one line.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── First admin account (used once by: npm run seed:admin) ───
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=your_secure_password_here
SEED_ADMIN_NAME=Hospital Administrator

# ─── Uploads ──────────────────────────────────────────────
UPLOAD_MAX_BYTES=10485760
